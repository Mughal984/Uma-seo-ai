PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_FILE=./data/umar-seo-ai.sqlite
CRAWL_MAX_PAGES=10
CRAWL_TIMEOUT_MS=10000

# Google OAuth (set only in the deployment environment; never commit real values)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Exact public origin, e.g. https://your-app.example.com
PUBLIC_BASE_URL=https://your-app.example.com
# Generate 32 random bytes and encode as 64 hexadecimal characters
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
